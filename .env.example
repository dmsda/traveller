# ==============================================================================
# Travellers — Environment Configuration Template
# ==============================================================================
# This project is currently structured as a client-side static web application.
# No secrets or API keys are required to build or run the project locally.
#
# If you integrate backend microservices or third-party APIs in the future,
# copy this file to .env.local and populate the values below.
# ==============================================================================

# Next.js Public Host URL (Optional, for OpenGraph canonical links)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Community API Endpoint (Optional, for future live backend integration)
# NEXT_PUBLIC_API_BASE_URL=https://api.travellers.example.com/v1
